{
  "name": "ftc-scout-server",
  "version": "2.0.0",
  "private": true,
  "description": "Express + MongoDB API for FTC Scout",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
