PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ftc-scout
CLIENT_ORIGIN=http://localhost:3000

# Google Sheet that scouts fill in (must be shared as "Anyone with the link")
SHEET_ID=1PWdTIUPcPH_HxHqmH5rk8OSlTxkeGzbelaZv0GlFBwA
# How often to pull the sheet into MongoDB, in seconds (0 disables)
SYNC_INTERVAL_SECONDS=60

# FTCScout season + region
FTC_SEASON=2026
FTC_REGION=JM

# FIRST FTC Events API (free key: https://ftc-events.firstinspires.org/services/API)
# Optional — enables alliances, advancement, full award lists, robot names, venues.
FTC_API_USER=
FTC_API_TOKEN=

ADMIN_SETUP_CODE=   # one-time code to claim the first admin at /setup (set on Vercel, mark Sensitive)

# Email updates (optional). Any SMTP account works; for Gmail turn on 2-step
# verification, create an app password, and URL-encode the @ as %40.
SMTP_URL=            # e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
MAIL_FROM=           # e.g. FTC Scout Jamaica <you@gmail.com>
SITE_URL=            # public address used in email links; Vercel sets this automatically
